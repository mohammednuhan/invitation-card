{
  "name": "luxury-wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Premium luxury digital wedding invitation website with React + Express + PostgreSQL",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "concurrently -n FRONTEND,BACKEND -c yellow,cyan \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "seed": "npm --prefix backend run seed",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs wedding-api",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup && pm2 save",
    "pm2:startup:windows": "pm2-startup install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
