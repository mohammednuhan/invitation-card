# ============================================
#  LUXURY WEDDING INVITATION - ENVIRONMENT
# ============================================

# ---------- SERVER ----------
PORT=5000

# ---------- MONGODB (Mongo Atlas) ----------
# Create a free cluster at https://www.mongodb.com/atlas
# Replace <user>, <password>, <cluster> with your own
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wedding?retryWrites=true&w=majority

# ---------- JWT (admin authentication) ----------
# Use a long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# ---------- ADMIN LOGIN ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- CLIENT ----------
# The URL where the React app runs
CLIENT_URL=http://localhost:5173
# Public base for uploaded files. In production set to the backend URL on Render
# e.g. https://your-backend.onrender.com
PUBLIC_BASE_URL=http://localhost:5000
