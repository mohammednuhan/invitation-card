# ============================================================
#  LUXURY WEDDING INVITATION - DEPLOYMENT ENVIRONMENT
#  All of these are configured in the Vercel dashboard under
#  Project -> Settings -> Environment Variables (add them to
#  Production, Preview and Development).
# ============================================================

# ---------- MONGODB (MongoDB Atlas) ----------
# Free cluster: https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wedding?retryWrites=true&w=majority

# ---------- JWT (admin authentication) ----------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# ---------- ADMIN LOGIN ----------
# Used only by the seed script to create the initial admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password

# ---------- FRONTEND / CORS ----------
# Base URL of the deployed frontend (used for CORS allow-list).
CLIENT_URL=https://your-app.vercel.app

# Public base for uploaded files (used by the admin upload endpoint).
# On Vercel this is the same domain as the frontend.
PUBLIC_BASE_URL=https://your-app.vercel.app

# Frontend build-time variable: same-origin API is the default on Vercel,
# so you only need to override this if the API lives on another host.
VITE_API_URL=/api
