# Frontend environment for the Luxury Wedding Invitation
# =======================================================

# Backend API base URL.
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (Vercel): leave unset to use the same-origin default "/api".
# Only set this if the API lives on a different host, e.g.:
# VITE_API_URL=https://your-backend.onrender.com/api
